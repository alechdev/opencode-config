{
  "theme": {
    "name": "synthwave84",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "editor": false,
    "paste": "compact",
    "image_preview": false
  },
  "session": {
    "sidebar": "auto",
