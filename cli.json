    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "layout": "horizontal"
  },
  "attention": {
    "enabled": false,
    "volume": 0.4
  }
}
