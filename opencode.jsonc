{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "codex-lb/gpt-5.6-sol",
  "agents": {
    "title": {
      "model": "codex-lb/gpt-5.6-luna"
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "permission": "allow",
  "plugin": [],
  "providers": {
    "codex-lb": {
      "name": "Codex LB",
      "env": ["CODEX_LB_API_KEY"],
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:CODEX_LB_BASE_URL}",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "detailed"
          },
          "variants": [
            {
              "id": "low",
              "settings": { "reasoningEffort": "low" }
            },
            {
              "id": "medium",
              "settings": { "reasoningEffort": "medium" }
            },
            {
              "id": "high",
              "settings": { "reasoningEffort": "high" }
            },
            {
              "id": "xhigh",
              "settings": { "reasoningEffort": "xhigh" }
            }
          ],
          "limit": {
            "context": 272000,
            "output": 65536
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "detailed"
          },
          "variants": [
            {
              "id": "low",
              "settings": { "reasoningEffort": "low" }
            },
            {
              "id": "medium",
              "settings": { "reasoningEffort": "medium" }
            },
            {
              "id": "high",
              "settings": { "reasoningEffort": "high" }
            },
            {
              "id": "xhigh",
              "settings": { "reasoningEffort": "xhigh" }
            }
          ],
          "limit": {
            "context": 272000,
            "output": 65536
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "detailed"
          },
          "variants": [
            {
              "id": "low",
              "settings": { "reasoningEffort": "low" }
            },
            {
              "id": "medium",
              "settings": { "reasoningEffort": "medium" }
            },
            {
              "id": "high",
              "settings": { "reasoningEffort": "high" }
            },
            {
              "id": "xhigh",
              "settings": { "reasoningEffort": "xhigh" }
            }
          ],
          "limit": {
            "context": 272000,
            "output": 65536
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "settings": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed"
          },
          "limit": {
            "context": 272000,
            "output": 65536
          }
        }
      }
    }
  },
  "provider": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Grok Composer 2.5 Fast",
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 256000
          },
          "modalities": {
            "input": ["text", "image"]
          },
          "cost": {
            "input": 0.50,
            "output": 2.50,
            "cache_read": 0.20
          }
        }
      }
    },
  },
  "compaction": {
    "prune": false
  },
}
