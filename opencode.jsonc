{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-5.6-sol",
  "agents": {
    "title": {
      "model": "codex-lb/gpt-5.6-luna"
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "permission": "allow",
  "providers": {
    "codex-lb": {
      "name": "Codex LB",
      "env": ["CODEX_LB_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai/responses",
      "settings": {
        "baseURL": "{env:CODEX_LB_BASE_URL}",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "detailed"
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "codex-lb-sleev": {
      "name": "Codex LB through Sleev",
      "env": ["CODEX_LB_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai/responses",
      "settings": {
        "baseURL": "{env:SLEEV_BASE_URL}",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "headers": {
        "sleev-harness": "opencode",
        "sleev-base-url": "{env:CODEX_LB_BASE_URL}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "detailed"
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    }
  },
  "provider": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Grok Composer 2.5 Fast",
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 256000
          },
          "modalities": {
            "input": ["text", "image"]
          },
          "cost": {
            "input": 0.50,
            "output": 2.50,
            "cache_read": 0.20
          }
        }
      }
    },
  },
  "compaction": {
    "prune": false
  },
}
